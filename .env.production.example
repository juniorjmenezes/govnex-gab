APP_NAME="GOVNEX GAB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ATENÇÃO: domínio ilustrativo — o real ainda é gabnex.f3sistemas.app.br até o
# DNS/hosting da f3-vps ser atualizado para o novo nome (ação fora do código).
APP_URL=https://govnexgab.f3sistemas.app.br
TRUSTED_PROXIES=10.240.0.0/24
GOVNEXGAB_BOOTSTRAP_DIR=/bootstrap

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gabinete_facil
DB_USERNAME=gabinete_facil
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
DB_QUEUE_RETRY_AFTER=1900
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="GovnexGab/1.0 (${APP_URL})"
GEOCODING_CONTACT_EMAIL=
GEOCODING_MINIMUM_INTERVAL_MS=1100
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

WHATSAPP_DRIVER=fake
WHATSAPP_SIMULATED=true
WHATSAPP_REAL_ENABLED=false
WHATSAPP_GATEWAY_URL=https://whatsapp.f3sistemas.app.br
WHATSAPP_CLIENT_CODE=GABINETE
WHATSAPP_GATEWAY_ACCOUNT_ID=0
WHATSAPP_REQUEST_SECRET=
WHATSAPP_CALLBACK_SECRET=
WHATSAPP_CALLBACK_SECRET_PREVIOUS=
WHATSAPP_CALLBACK_PREVIOUS_VALID_UNTIL=
WHATSAPP_PHONE_HASH_SECRET=

TSE_CDN_URL=https://cdn.tse.jus.br/estatistica/sead/odsele
TSE_USER_AGENT="GovnexGab/1.0 (${APP_URL})"
TSE_CONNECT_TIMEOUT=30
TSE_TIMEOUT=600
TSE_MAX_DOWNLOAD_MEGABYTES=2048
TSE_MANUAL_UPLOAD_MAX_MEGABYTES=1024
TSE_MAX_UNCOMPRESSED_MEGABYTES=16384
TSE_MAX_COMPRESSION_RATIO=200
TSE_MAX_ARCHIVE_ENTRIES=500
TSE_POLLING_LOCATIONS_CHUNK_SIZE=25000
TSE_QUEUE_CONNECTION=database
TSE_ELECTORATE_MIN_MUNICIPALITIES=5000
TSE_ELECTORATE_MAX_MUNICIPALITIES=6500
TSE_WORKER_MEMORY_LIMIT=2048M

POLLINGDATA_URL=https://flex.pollingdata.com.br/api/polls/candidates
POLLINGDATA_USER_AGENT="GovnexGab/1.0 (${APP_URL})"
POLLINGDATA_TIMEOUT=30
