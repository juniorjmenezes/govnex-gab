APP_NAME="GOVNEX GAB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gabinete_facil
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="GovnexGab/1.0 (${APP_URL})"
GEOCODING_CONTACT_EMAIL=
GEOCODING_MINIMUM_INTERVAL_MS=1100
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

WHATSAPP_DRIVER=fake
WHATSAPP_SIMULATED=true
WHATSAPP_REAL_ENABLED=false
WHATSAPP_GATEWAY_URL=https://whatsapp.f3sistemas.app.br
WHATSAPP_CLIENT_CODE=GABINETE
WHATSAPP_GATEWAY_ACCOUNT_ID=0
WHATSAPP_REQUEST_SECRET=
WHATSAPP_CALLBACK_SECRET=
WHATSAPP_CALLBACK_SECRET_PREVIOUS=
WHATSAPP_CALLBACK_PREVIOUS_VALID_UNTIL=
WHATSAPP_PHONE_HASH_SECRET=

TSE_TIMEOUT=600
TSE_POLLING_LOCATIONS_CHUNK_SIZE=25000
TSE_QUEUE_CONNECTION=database
TSE_WORKER_MEMORY_LIMIT=2048M

# Todos os datasets do TSE vêm da GOVNEX API (ver GovnexApiClient). Sem
# GOVNEX_API_KEY, ainda funciona, com limite de requisições mais baixo.
GOVNEX_API_URL=http://127.0.0.1:8020/api/v1
GOVNEX_API_KEY=

# GOVNEX Hub — SSO (OIDC) e sincronização de pessoas/vínculos.
# Ver docs/INTEGRACAO_GOVNEX_HUB.md. Os três segredos abaixo são gerados no
# Hub e nunca ficam versionados:
#  - HUB_OIDC_CLIENT_ID/SECRET: `php artisan hub:registrar-cliente-oidc GAB
#    --redirect=<HUB_OIDC_REDIRECT>` rodado NO HUB;
#  - HUB_API_SECRET: o `client_secret` do Sistema GAB no Hub — o mesmo segredo
#    autentica a leitura de /api/v1 e assina o webhook que chega aqui.
HUB_BASE_URL=http://127.0.0.1:8030
HUB_SISTEMA_CODIGO=GAB
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
HUB_OIDC_REDIRECT="${APP_URL}/auth/hub/callback"
HUB_API_SECRET=
HUB_TIMEOUT=15
HUB_WEBHOOK_WINDOW_SECONDS=300

POLLINGDATA_URL=https://flex.pollingdata.com.br/api/polls/candidates
POLLINGDATA_USER_AGENT="GovnexGab/1.0 (${APP_URL})"
POLLINGDATA_TIMEOUT=30
